# ==============================================================================
# NEXUS ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or .env.local and adjust for your local or production deployment.
# NEVER commit .env or .env.local to version control.
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server Network Settings
PORT=3001
HOST=0.0.0.0

# CORS Allowed Origins
# Comma-separated list of allowed origins (e.g., http://localhost:3000,https://nexus.campus)
# In production, DO NOT use wildcard '*'
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Admin Authentication (One-Password Model)
# Server-side password hash (scrypt format: <hex_derived_key>:<hex_salt>).
# CRITICAL SECURITY RULE: NEVER prefix this with VITE_ or expose it to the frontend bundle.
# Generate a hash using: npx tsx scripts/hash-admin-password.ts <your_password>
ADMIN_PASSWORD_HASH=replace_with_hash
ADMIN_DEFAULT_USER=admin@nexus.campus

# Media & File Storage
# Storage driver: 'local' (filesystem) or 's3' (AWS S3 / Cloudflare R2 / MinIO)
MEDIA_STORAGE_DRIVER=local

# Local storage path (used when MEDIA_STORAGE_DRIVER=local)
MEDIA_STORAGE_LOCAL_DIR=./data/media

# S3 / Cloudflare R2 / MinIO settings (used when MEDIA_STORAGE_DRIVER=s3)
# MEDIA_STORAGE_S3_BUCKET=nexus-media-bucket
# MEDIA_STORAGE_S3_REGION=us-east-1
# MEDIA_STORAGE_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# MEDIA_STORAGE_S3_ACCESS_KEY_ID=your_access_key_id
# MEDIA_STORAGE_S3_SECRET_ACCESS_KEY=your_secret_access_key
# MEDIA_STORAGE_S3_FORCE_PATH_STYLE=false

# Rate Limiting Settings
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=1000

# Client Vite Development Flags
DISABLE_HMR=true

# ==============================================================================
# CLOUDINARY IMAGE BASE CONFIGURATION
# ==============================================================================
# Public delivery parameters (client-safe):
VITE_CLOUDINARY_CLOUD_NAME=plg8gola
VITE_CLOUDINARY_FOLDER=aarambh

# Cloudinary Administrative / Migration Credentials (BACKEND / SCRIPTS ONLY):
# IMPORTANT SECURITY RULE: NEVER prefix these with VITE_ or expose them to the frontend bundle.
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret

